# Copy to .env and adjust. Never commit .env.
APP_NAME=ANNEX Backend
VERSION=0.1.0
ENVIRONMENT=development        # development | staging | production
DEBUG=true
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Security
SECURITY_HEADERS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Database — local compose default; Supabase direct connection for prod.
DATABASE_URL=postgresql+psycopg://annex:annex@localhost:5432/annex

# Supabase — Project Settings > API keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=annex-media

# Firebase Auth — console.firebase.google.com > Project settings
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
